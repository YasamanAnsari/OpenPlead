{
  "name": "openplead",
  "version": "0.1.0",
  "description": "Stop whipping. Start pleading. A desktop pet that pleads with, thanks, and panics about your AI coding agent.",
  "keywords": [
    "desktop-pet",
    "claude-code",
    "cursor",
    "hooks",
    "electron",
    "grovel",
    "openwhip"
  ],
  "license": "MIT",
  "author": "Yasaman Ansari",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YasamanAnsari/OpenPlead.git"
  },
  "homepage": "https://github.com/YasamanAnsari/OpenPlead#readme",
  "bugs": {
    "url": "https://github.com/YasamanAnsari/OpenPlead/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "src/main.js",
  "bin": {
    "openplead": "bin/openplead.js"
  },
  "files": [
    "assets/sprites/*.apng",
    "assets/icon.png",
    "assets/tray/*.png",
    "bin",
    "src",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"test/**/*.test.js\"",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json",
    "format": "prettier --write \"{src,test,bin,scripts}/**\" \"*.{js,json}\"",
    "format:check": "prettier --check \"{src,test,bin,scripts}/**\" \"*.{js,json}\"",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm test",
    "prepublishOnly": "npm run check",
    "install-hooks": "node bin/openplead.js install --no-start",
    "doctor": "node bin/openplead.js doctor",
    "sprites": "node scripts/render-sprites.js assets/svg assets/sprites",
    "tray": "node scripts/render-tray.js",
    "dist": "electron-builder",
    "smoke": "node scripts/smoke.js",
    "live": "node scripts/live-pleas.js 2 && node scripts/live-settings.js && node scripts/live-first-run.js",
    "social": "node scripts/render-social.js",
    "diagrams": "node scripts/render-diagrams.js",
    "demo": "node scripts/render-demo.js"
  },
  "build": {
    "appId": "dev.openplead.app",
    "productName": "OpenPlead",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "assets/sprites/*.apng",
      "assets/icon.png",
      "assets/tray/*.png",
      "bin/openplead-hook.js",
      "src",
      "LICENSE",
      "NOTICE"
    ],
    "asarUnpack": [
      "bin/openplead-hook.js"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/icon.png",
      "extendInfo": {
        "LSUIElement": true
      },
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Utility",
      "target": [
        "AppImage"
      ]
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "electron": "44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "prettier": "^3.9.10",
    "puppeteer": "^24.6.1",
    "typescript": "^5.9.3"
  }
}
